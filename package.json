{
  "name": "flop-reset-org",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false --allowImportingTsExtensions",
    "test:domain": "node --experimental-strip-types tests/results.test.ts",
    "test:competition": "node --experimental-strip-types tests/competitions.test.ts",
    "test:identity": "node --experimental-strip-types tests/opponents.test.ts",
    "test:import": "node --experimental-strip-types tests/importValidation.test.ts && node --experimental-strip-types tests/ballchasingImport.test.ts",
    "test:rebuild": "node --experimental-strip-types tests/rebuild.test.ts && node --experimental-strip-types tests/playoffAdmin.test.ts",
    "test:directory": "node --experimental-strip-types tests/leagueDirectory.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "next": "16.2.12",
    "papaparse": "^5.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
